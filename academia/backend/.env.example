# ============================================================
# .env.example - MODELO de configuração
# Copie este arquivo para backend/.env e preencha os valores:
#   cp backend/.env.example backend/.env
# NUNCA envie o .env verdadeiro para o GitHub.
# ============================================================

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development

# ---------- Banco de dados (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_a_senha_do_seu_postgres
DB_NAME=academia

# ---------- Sessão (cookies) ----------
# Mínimo 16 caracteres. Para gerar um segredo aleatório, rode no terminal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cole_aqui_o_segredo_gerado

# ---------- Pix (opcional: sem isso o QR Code não é gerado) ----------
PIX_CHAVE=sua_chave_pix
PIX_NOME=NOME DO RECEBEDOR
PIX_CIDADE=SUA CIDADE